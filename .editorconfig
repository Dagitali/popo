# .editorconfig
# popo
#
# Copyright © 2026 Dagitali LLC. All rights reserved.
#
# EditorConfig configuration for shared editor and IDE formatting defaults.
#
# EditorConfig is a widely supported standard for defining and maintaining
# consistent coding styles between different editors and IDEs. This file
# defines the baseline formatting rules for this repository, with language-
# specific overrides for various file types. By adhering to these rules,
# contributors can reduce formatting inconsistencies and improve code quality.
#
# Responsibilities
# - Define baseline whitespace, newline, charset, and indentation behavior
#   across editors and IDEs.
# - Keep language-specific indentation rules close to the file patterns they
#   affect.
# - Reduce formatting churn between contributors and automated formatters.
#
# Maintainer Notes
# - Keep `root = true` so parent-directory EditorConfig files do not affect
#   this repository.
# - Keep Makefile indentation tab-based; GNU Make recipe lines require tabs.
# - Keep Python indentation aligned with the formatter and lint configuration.
#
# References
# - EditorConfig file format reference:
#   https://editorconfig.org/#file-format-details
# - Standard EditorConfig examples:
#   https://github.com/jokeyrhyme/standard-editorconfig

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{toml,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab
